  "query": "UPDATE review_tasks SET status = 'cancelled', updated_at = now()\n            WHERE document_id = $1 AND kind = $2 AND status IN ('open', 'initiated', 'overdue')\n              AND ($3::date IS NULL OR due_date <> $3)\n          RETURNING due_date",
