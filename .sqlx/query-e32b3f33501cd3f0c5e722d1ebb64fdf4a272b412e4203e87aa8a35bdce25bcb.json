  "query": "INSERT INTO review_tasks (id, document_id, kind, due_date, status)\n             VALUES ($1, $2, $3, $4, CASE WHEN $4::date < $5::date THEN 'overdue'::task_status ELSE 'open'::task_status END)\n             ON CONFLICT (document_id, kind, due_date) DO NOTHING RETURNING id",
