{
  "db_name": "PostgreSQL",
  "query": "SELECT d.id, d.external_id, d.title, d.status::text AS \"status!\", t.name AS type_name, dep.code, dep.name AS dept,\n                  d.next_review_date, d.renewal_date, d.expiration_date\n             FROM documents d\n             JOIN document_types t ON t.id = d.document_type_id\n             JOIN departments dep ON dep.id = d.department_id\n            WHERE d.deleted_at IS NULL AND NOT d.is_confidential AND d.status NOT IN ('superseded', 'archived')",
