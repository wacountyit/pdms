  "db_name": "PostgreSQL",
  "query": "SELECT id, document_type_id, department_id, owner_id, inherit_acl, is_confidential,\n                  status AS \"status: DocumentStatus\", next_review_date, renewal_date, expiration_date,\n                  external_id, title\n             FROM documents\n            WHERE deleted_at IS NULL\n              AND status IN ('active', 'renewal_due', 'overdue', 'expired')\n              AND ($1::uuid IS NULL OR id = $1)",
