{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.name, t.slug, t.color, t.description, t.is_curated,\n                  (SELECT count(*) FROM document_tags dt JOIN documents d ON d.id = dt.document_id\n                    WHERE dt.tag_id = t.id AND d.deleted_at IS NULL) AS \"document_count!\"\n             FROM tags t ORDER BY t.is_curated DESC, t.name",
