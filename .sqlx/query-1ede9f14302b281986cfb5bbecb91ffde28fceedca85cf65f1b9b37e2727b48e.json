  "query": "SELECT d.id, d.external_id, d.title, t.name AS type_name, dep.name AS department, d.status::text AS \"status!\"\n             FROM documents d JOIN document_types t ON t.id = d.document_type_id\n             JOIN departments dep ON dep.id = d.department_id\n            WHERE d.id = $1",
