{
  "db_name": "PostgreSQL",
  "query": "SELECT v.blob_sha256 AS \"sha!\", b.media_type, b.size_bytes, d.external_id, d.title, d.department_id,\n                  d.owner_id, d.inherit_acl, d.is_confidential\n             FROM document_versions v\n             JOIN blobs b ON b.sha256 = v.blob_sha256\n             JOIN documents d ON d.id = v.document_id\n            WHERE v.document_id = $1 AND v.version_no = $2 AND d.deleted_at IS NULL",
